AMENT_PREFIX_PATH=/opt/ros/jazzy
COLCON=1
DEBIAN_FRONTEND=noninteractive
HOME=/root
HOSTNAME=toby-desktop
LANG=C.UTF-8
LC_ALL=C.UTF-8
LD_LIBRARY_PATH=/opt/ros/jazzy/lib/x86_64-linux-gnu:/opt/ros/jazzy/lib
PATH=/opt/ros/jazzy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/ros2_ws/build/nmea_navsat_driver
PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROS_DISTRO=jazzy
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SHLVL=1
TERM=xterm
_=/usr/bin/colcon
